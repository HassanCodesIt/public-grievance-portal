# CM Kerala Public Grievance Redressal Portal
# Environment Configuration Template (.env.example)
# DO NOT COMMIT REAL SECRETS TO SOURCE CONTROL

# ----------------- Database Configuration -----------------
# Neon PostgreSQL URL (production) or local SQLite (development/tests)
# Example Neon URL: postgresql://<user>:<password>@<neon-host>/neondb?sslmode=require
DATABASE_URL=sqlite:///./grievances.db

# ----------------- Authentication & Security -----------------
# Secret key used for signing JWT bearer tokens (min 32 characters)
JWT_SECRET=super-secret-cm-kerala-key-2026-minimum-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ----------------- AI Assistant (Groq Cloud) -----------------
# Groq API key from https://console.groq.com/keys
# If left blank, the portal automatically engages the labeled keyword fallback engine
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ----------------- Server & CORS Settings -----------------
# Environment mode: 'development' or 'production'
ENV=development

# Comma-separated list of allowed frontend origins for CORS
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:8443,https://your-app.onrender.com,*

# ----------------- Frontend Build Variable -----------------
# Used by Vite build for targeting the backend REST API
VITE_API_URL=http://localhost:8000/api
